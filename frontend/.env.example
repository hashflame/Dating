# Базовый URL API. Пустое значение = относительные пути через dev-прокси Vite.
# Оставляй пустым: у API закрыт CORS для всех origin кроме web.telegram.org,
# поэтому обращаться к нему напрямую из браузера нельзя — только через прокси.
VITE_API_BASE_URL=

# Куда dev-прокси Vite перенаправляет /api. Только при npm run dev.
VITE_API_PROXY_TARGET=https://api-production-3ead.up.railway.app

# Подменять оболочку клиента Telegram (тема, вьюпорт), чтобы открывать
# приложение в обычном браузере. Пользователь при этом настоящий — см. ниже.
# Работает только в dev-сборке. Ставь 0, когда запускаешь внутри Telegram.
VITE_MOCK_TELEGRAM=1

# Токен бота — нужен, чтобы входить на реальный API из браузера: dev-сервер
# подписывает им initData (vite/dev-telegram-auth.ts), потому что сервер
# принимает только подлинную подпись. Без префикса VITE_, в бандл не попадает
# и в браузер не уходит. Значение — то же, что Telegram__BotToken на стенде.
# Пусто и VITE_MOCK_TELEGRAM=1 — вход вернёт 401, экраны будут недоступны.
# Подробнее: docs/real-backend.md
TELEGRAM_BOT_TOKEN=

# Включить мобильную dev-консоль eruda внутри Telegram (1/0).
VITE_DEBUG_CONSOLE=0

# Публичный хост туннеля (без https://) — нужен только чтобы через туннель
# работала живая перезагрузка. Пример: abc-123.trycloudflare.com
VITE_PUBLIC_HOST=

# От чьего имени входить в браузере (VITE_MOCK_TELEGRAM=1). Твой настоящий
# аккаунт: id — у @userinfobot, юзернейм без «@». Бэкенд опознаёт людей по id,
# юзернейм пишет в TelegramUsername и из него же берётся аватар для импорта фото.
# Панель разработки позволяет переключиться на другого, не трогая .env.
# Без префикса VITE_ намеренно: с ним значения попали бы в production-бандл.
DEV_USER_ID=
DEV_USER_NAME=
DEV_USER_USERNAME=

# ВРЕМЕННО, только для ручного тестирования на демо-данных (пока не убрали
# demo-режим с бэкенда — см. docs/real-backend.md). Для локального npm run dev.
# Секрет из Railway (DevLogin__Secret) — заданный, включает вход по 10
# фиксированным демо-аккаунтам вместо подписи initData: не нужен
# TELEGRAM_BOT_TOKEN, но и войти под своим реальным Telegram-id так нельзя.
# Без префикса VITE_, в бандл не попадает и в браузер не уходит — секрет
# подставляет vite/dev-login-auth.ts на стороне Node.
DEV_LOGIN_SECRET=

# То же самое, но для ЗАДЕПЛОЕННОГО dev-стенда фронта, не для локального .env:
# там нет dev-сервера, который спрячет секрет, поэтому он намеренно с префиксом
# VITE_ и уходит прямо в браузерный бандл (см. docs/real-backend.md — риск и
# альтернативы обсуждены там). Задаётся только как переменная окружения на
# Railway-сервисе dev-стенда, вместе с VITE_MOCK_TELEGRAM=1, VITE_API_BASE_URL
# (прямой URL API — прокси там нет) и NODE_ENV=development (иначе панель
# разработки будет вырезана как из настоящего прода).
VITE_DEV_LOGIN_SECRET=

# PostHog: аналитика продукта. Пусто = выключена (SDK не грузится, запросов
# наружу нет) — так по умолчанию локально и в любой сборке без переменной.
# Ключ проекта (`phc_…`) задаётся переменной окружения на Railway. Прод и
# dev-стенд — РАЗНЫЕ проекты в PostHog, иначе тестовые прогоны испортят метрики.
VITE_POSTHOG_KEY=

# Регион PostHog. EU — по умолчанию: данные пользователей из Беларуси и ЕС
# не должны уезжать в США. Менять не нужно.
VITE_POSTHOG_HOST=https://eu.i.posthog.com
