# Базовый URL API. Пустое значение = относительные пути через dev-прокси Vite.
# Для работы в браузере оставляй пустым: у API закрыт CORS для чужих origin.
VITE_API_BASE_URL=

# Куда dev-прокси Vite перенаправляет /api. Только при npm run dev.
# Как переключиться на реальный API — docs/real-backend.md
#
#   реальный API — только вместе с VITE_MOCK_TELEGRAM=0 и запуском в Telegram
VITE_API_PROXY_TARGET=https://api-production-3ead.up.railway.app
#
#   локальная заглушка — щёлкать экраны в браузере
#   VITE_API_PROXY_TARGET=http://localhost:5000

# Мокать окружение Telegram, чтобы открывать приложение в обычном браузере.
# Работает только в dev-сборке. Ставь 0, когда тестируешь внутри Telegram.
VITE_MOCK_TELEGRAM=1

# Включить мобильную dev-консоль eruda внутри Telegram (1/0).
VITE_DEBUG_CONSOLE=0
